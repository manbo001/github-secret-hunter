# ============================================================
# GitHub Secret Hunter - 环境变量配置模板
#
# 部署步骤：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 修改下方配置项为真实值（至少需改 DB_USER / DB_PASS / APP_ENCRYPTION_KEY）
#   3. 导入数据库：         mysql -u root -p github_secret_hunter < sql/schema.sql
#   4. 设置文件权限：       chown -R www-data:www-data . && chmod 640 .env
#   5. 重启 Web 服务：      systemctl restart php-fpm nginx
#   6. 浏览器访问，用默认账号登录：admin / Admin@123456（首次登录强制改密）
#      若配置了 ADMIN_USER，则用户名为该值
#
# 切勿将 .env 提交到版本控制！
# ============================================================

# ---- 数据库配置 ----
# MariaDB/MySQL 连接信息，需先创建空库：CREATE DATABASE github_secret_hunter CHARACTER SET utf8mb4;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=github_secret_hunter
DB_USER=your_db_user
DB_PASS=your_db_password

# ---- 应用加密密钥 ----
# AES-256 密钥，用于加密存储 GitHub Token 和通知渠道配置
# 生成命令：openssl rand -base64 32   （结果填入等号后，勿带引号）
# 注意：更换此密钥后，已加密的 Token 和通知配置将无法解密，需重新录入
APP_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# ---- 应用环境 ----
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# 对外访问地址（通知消息里「查看全部命中结果」链接使用），如 http://192.168.2.24
# 留空则通知消息不带结果页链接
APP_URL=

# ---- 出站请求域名白名单（SSRF 防护）----
# 系统仅允许向以下域名发起 HTTP 请求，多个域名用英文逗号分隔
# 如需添加企业自建 SMTP / Webhook 域名，请在此追加
SSRF_ALLOWED_HOSTS=api.github.com,gitee.com,gitcode.com,oapi.dingtalk.com,qyapi.weixin.qq.com,open.feishu.cn,open.larksuite.com,smtp.exmail.qq.com,smtp.qq.com,smtp.163.com,smtp.gmail.com

# ---- 登录防爆破配置 ----
# 连续失败 LOGIN_MAX_ATTEMPTS 次后锁定账号 LOGIN_LOCK_MINUTES 分钟
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- 初始管理员用户名 ----
# 首次访问登录页时，自动把默认账号 admin 重命名为该用户名（密码仍为 Admin@123456，首次登录强制改密）
# 留空或不配置 = 使用默认 admin；部署后也可在「系统设置 → 管理员账号」中修改（此后 .env 不再生效）
ADMIN_USER=admin

# ---- 会话安全配置 ----
# 会话不活动超时（秒），超时后自动登出，需重新登录。默认 28800 = 8 小时，0 = 不超时
# 注意：后台「系统设置」页可动态调整此值（存入数据库，优先级高于此处）
SESSION_LIFETIME=28800

# ---- GitHub API 配置 ----
# GitHub API 基础地址（无需改动，除非使用 GitHub Enterprise）
GITHUB_API_BASE=https://api.github.com
# 每分钟请求上限（未认证 10 次/分钟，认证后 30 次/分钟，建议不超过 30）
GITHUB_RATE_LIMIT=30
# 单次 API 请求总超时（秒）。启用命中片段后响应较大，慢链路建议 ≥ 90
GITHUB_API_TIMEOUT=90
# 命中片段（text-match）：响应体放大数倍，含代码上下文。
# 弱网/链路不稳导致传输中断（transfer closed）时设为 0 关闭，可大幅提高成功率
# 注意：后台「数据设置」页可动态开关此功能（存入数据库，优先级高于此处）
GITHUB_TEXT_MATCH=1
# 后台翻页请求间隔（秒）。GitHub Search API 有限速，间隔过小会触发 403/429，建议 >= 5
GITHUB_SEARCH_INTERVAL=7
# 任务完成后自动复查新增的间隔（分钟）。复查只入库并推送新增结果；0 = 关闭复查
# 注意：GitHub 单个搜索查询最多返回前 1000 条结果，超出部分无法获取
RECHECK_INTERVAL_MINUTES=30